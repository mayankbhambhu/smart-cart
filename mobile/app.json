{
  "expo": {
    "name": "FreshFlow",
    "slug": "freshflow",
    "scheme": "freshflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#1f8a4c" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.freshflow.customer",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FreshFlow uses the camera to scan product barcodes into your smart cart.",
        "NSLocationWhenInUseUsageDescription": "FreshFlow uses your location to find nearby stores and check stock."
      }
    },
    "android": {
      "package": "app.freshflow.customer",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#1f8a4c" },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      ["expo-camera", { "cameraPermission": "FreshFlow uses the camera to scan product barcodes into your smart cart." }],
      ["expo-location", { "locationWhenInUsePermission": "FreshFlow uses your location to find nearby stores and check stock." }],
      ["@stripe/stripe-react-native", { "merchantIdentifier": "merchant.app.freshflow", "enableGooglePay": true }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "stripePublishableKey": "",
      "googleClientIds": { "ios": "", "android": "", "web": "" }
    }
  }
}
