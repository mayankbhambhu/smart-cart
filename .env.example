# ---------- API (backend/.env) ----------
DEBUG=false
DATABASE_URL=postgresql+psycopg://freshflow:freshflow@localhost:5432/freshflow
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=https://shop.example.com,https://store.example.com,https://admin.example.com
CURRENCY=INR
TAX_RATE=0.05

# Payments: mock (sandbox, default) or live
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Social / phone login
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id...,android-client-id...
APPLE_BUNDLE_IDS=app.freshflow.customer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Dashboards (web) ----------
API_URL=http://localhost:8000          # server-to-server
PUBLIC_API_URL=http://localhost:8000   # what browsers use for live WebSocket updates
SESSION_SECRET=another-long-random-string
