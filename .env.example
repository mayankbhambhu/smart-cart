# ---------- API (backend/.env) ----------
DEBUG=false
DATABASE_URL=postgresql+psycopg://freshflow:freshflow@localhost:5432/freshflow
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=https://shop.example.com,https://store.example.com,https://admin.example.com
CURRENCY=INR
TAX_RATE=0.05

# Payments: mock (sandbox, default) or live
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Sign-in options (each button switches on once its settings are filled in)
# Google: OAuth client IDs from Google Cloud Console → APIs & Services → Credentials
GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_IDS=app.freshflow.customer
# Firebase email magic link: Firebase console → Project settings → General (web app config)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=my-project.firebaseapp.com
EMAIL_LINK_CONTINUE_URL=http://localhost:8001/auth/email-link
# Single sign-on (OpenID Connect): Microsoft Entra ID, Google Workspace, Okta, Auth0, Keycloak...
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with Microsoft
API_PUBLIC_URL=http://localhost:8000
SSO_ALLOWED_REDIRECTS=http://localhost:8001/,http://localhost:8002/,http://localhost:8003/,freshflow://,exp://
# Phone OTP by SMS (Twilio). Recommended: Twilio Verify, which sends and checks the code itself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Only for plain SMS instead of Verify:
TWILIO_FROM_NUMBER=
# FREE option instead of Twilio: "SMS Gateway for Android" app sends texts from your own SIM.
# Leave SMSGATE_URL out for cloud mode; local mode: http://<phone-ip>:8080/message
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
PHONE_DEFAULT_COUNTRY_CODE=+91

# ---------- Dashboards (web) ----------
API_URL=http://localhost:8000          # server-to-server
PUBLIC_API_URL=http://localhost:8000   # what browsers use for live WebSocket updates
SESSION_SECRET=another-long-random-string
# Where each dashboard lives: signing in at the wrong one sends you to the one for your role
CUSTOMER_APP_URL=http://localhost:8001
STORE_APP_URL=http://localhost:8002
ADMIN_APP_URL=http://localhost:8003
