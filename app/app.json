{
  "expo": {
    "name": "FreshFlow",
    "slug": "freshflow",
    "scheme": "freshflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f8a4c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mayankbhambhu.freshflow",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FreshFlow uses the camera to scan product barcodes into your smart cart.",
        "NSLocationWhenInUseUsageDescription": "FreshFlow uses your location to find nearby stores and check stock."
      }
    },
    "android": {
      "package": "com.mayankbhambhu.freshflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f8a4c"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "FreshFlow uses the camera to scan product barcodes into your smart cart.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreshFlow uses your location to find nearby stores and check stock."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.app.freshflow",
          "enableGooglePay": true
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "stripePublishableKey": "",
      "googleClientIds": {
        "ios": "",
        "android": "",
        "web": ""
      }
    }
  }
}
